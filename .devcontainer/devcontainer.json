{
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "forwardPorts": [
    3000,
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
      },
      "extensions": [
        "Vue.volar",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "postCreateCommand": "CI=true pnpm install"
}
